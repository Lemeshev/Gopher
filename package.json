{
  "name": "gopher-life",
  "version": "1.3.29",
  "description": "Interactive pet game with Go gopher mascot",
  "main": "index.js",
  "scripts": {
    "sync": "node tools/sync-www.js",
    "build": "node tools/sync-www.js && cd android && ./gradlew assembleRelease && cd ../.. && node tools/gh-release.js",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "verify": "node tools/verify.js",
    "render": "node tools/render-check.js",
    "store:assets": "node tools/store-assets.js",
    "apk:desktop": "npm run build && node tools/copy-apk.js",
    "release": "node tools/release.js",
    "github:release": "node tools/gh-release.js",
    "rustore:meta": "node tools/rustore-publish.js meta",
    "rustore:check": "node tools/rustore-publish.js check --go",
    "rustore:status": "node tools/rustore-publish.js status --go",
    "rustore:publish": "node tools/rustore-publish.js all"
  },
  "keywords": ["game", "android", "gopher"],
  "author": "Лемешев Виктор (vk.com/VL)",
  "license": "MIT"
}
