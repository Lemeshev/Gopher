{
  "name": "gopher-life",
  "version": "1.0.0",
  "description": "Interactive pet game with Go gopher mascot",
  "main": "index.js",
  "scripts": {
    "sync": "node tools/sync-www.js",
    "build": "node tools/sync-www.js && cd android && ./gradlew assembleRelease",
